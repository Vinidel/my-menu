# Supabase (required for employee auth)
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (required when CAPTCHA is enabled)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# CAPTCHA toggle (non-production only)
# production (NODE_ENV=production) always enforces CAPTCHA
# set to false in development/test to disable
ORDERS_CAPTCHA_ENABLED=true

# OpenAI (required for menu vision)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MENU_VISION_MODEL=gpt-5.2
OPENAI_MENU_VISION_TIMEOUT_MS=120000

# Menu import storage (private Supabase Storage bucket)
MENU_IMPORT_BUCKET=menu-imports

# Menu import access control (admin allowlist)
# Comma-separated list of e-mails allowed to import/process menu images
MENU_IMPORT_ALLOWED_EMAILS=vinidroid@gmail.com
